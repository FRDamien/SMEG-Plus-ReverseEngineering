<?xml version="1.0" encoding="UTF-8" ?>
<config>
    <languages>
        <language name="SpanishEs" basename="Spanish" defaultvariant="yes">
            <library name="LTTS7${basename}" entrypoint="${name}" />
            <info description="Castilian Spanish" />
            <resources path="modules/${basename}">
                <resource class="base" type="lexicalinfo" name="${name}" />
                <resource class="base" type="lexicon" name="${name}" />
            </resources>
            <languagealiases>
                <alias type="internal" name="${name}" />
                <alias type="IETF" name="es-ES" />
                <alias type="WinLangid" name="1034" />
                <alias type="generic" name="ES" />
                <alias type="generic" name="Castilian" />
                <alias type="generic" name="CastilianSpanish" />
                <alias type="generic" name="es" />
                <alias type="generic" name="Spanish" />
            </languagealiases>
            <modes>
                <mode name="default">
                    <parameters />
                    <resources>
                        <remove class="" type="" name="" />
                        <add class="base" type="" name="" />
                    </resources>
                </mode>
            </modes>
        </language>
    </languages>
</config>
