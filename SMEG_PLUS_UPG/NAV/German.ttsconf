<?xml version="1.0" encoding="UTF-8" ?>
<config>
    <languages>
        <language name="German" basename="German" defaultvariant="yes">
            <library name="LTTS7${basename}" entrypoint="${name}" />
            <info description="${basename}" />
            <resources path="modules/${basename}">
                <resource class="base" type="lexicalinfo" name="${name}" />
                <resource class="base" type="lexicon" name="lexicon_event" />
                <resource class="base" type="lexicon" name="lexicon_location" />
                <resource class="base" type="lexicon" name="${name}" />
            </resources>
            <languagealiases>
                <alias type="internal" name="${name}" />
                <alias type="IETF" name="de-DE" />
                <alias type="WinLangid" name="1031" />
                <alias type="generic" name="de" />
            </languagealiases>
            <modes>
                <mode name="default">
                    <parameters>
                        <phonetic secondaccent="TRUE" />
                    </parameters>
                    <resources>
                        <remove class="" type="" name="" />
                        <add class="base" type="" name="" />
                    </resources>
                </mode>
            </modes>
        </language>
    </languages>
</config>
